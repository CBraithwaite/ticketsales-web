# --- Public — exposed to the browser bundle. MUST be prefixed with NEXT_PUBLIC_.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5080

# --- Server-only — used inside Server Components / route handlers.
API_INTERNAL_BASE_URL=http://localhost:5080

# --- NextAuth (Auth.js v5)
# AUTH_SECRET is the symmetric key used to sign the session JWT cookie.
# Generate one with:  openssl rand -base64 32
AUTH_SECRET=dev-only-replace-me-with-openssl-rand-base64-32
# Auth.js URL — for v5 in dev this can be left at http://localhost:3000.
AUTH_URL=http://localhost:3000
# Trust the host header in dev. Always false in production behind a real proxy.
AUTH_TRUST_HOST=true
